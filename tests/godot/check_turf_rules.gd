extends "res://tests/godot/helpers/creative_fixture.gd"
func _initialize() -> void:call_deferred("_run")
func _run() -> void:
	await prepare(5,"sunset_park")
	var data:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://assets/maps/sunset_park_surfaces.json"))
	expect(game.ink.turf_total==int(data.turfCells),"entire map floor/ramps count, with no objective-region mask")
	expect(game.get("area")==null and game.frontend.get("rule_choice")==null,"removed mode has no match or selector state")
	expect(game.frontend.profile.text.contains("TURF WAR"),"preparation names only full-map turf")
	expect(not game.hud_root.find_child("ZoneCount",true,false),"area countdown HUD removed")
	game.paint_at_world(Vector3(15,.04,24),0,2,.4,Vector3.ZERO,0,walker)
	game.paint_at_world(Vector3(-15,.04,-24),1,2,.6,Vector3.ZERO,0,bot)
	expect(game.ink.coverage(0)>0 and game.ink.coverage(1)>0,"far-away floor on both ends contributes")
	var counts:Array=game.ink.counts.duplicate();game._update_hud()
	expect(game.ink.counts==counts,"HUD stays read-only")
	game.round_left=.1;game._physics_process(.2)
	expect(game.phase=="finish","full map ends at the time limit without area overtime")
	game._judge_round()
	expect(game.judged_coverage==[game.ink.coverage(0),game.ink.coverage(1)],"results read the full CPU grid")
	await finish("full-map scoring at both ends, read-only HUD, removed area UI/state, natural timer and coverage results")
